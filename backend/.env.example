# EmotionCall AI backend — copy to .env and fill in. NEVER commit the real .env.

# HTTP/WebSocket port the backend listens on.
PORT=8080

# Deepgram API key (streaming + prerecorded speech-to-text with diarization).
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic API key (emotion/intent analysis + post-call report via Claude).
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude models. Sonnet for fast realtime analysis, Opus for the post-call report.
CLAUDE_REALTIME_MODEL=claude-sonnet-4-6
CLAUDE_REPORT_MODEL=claude-opus-4-8

# Minimum gap (ms) between realtime LLM analysis calls, to control latency + cost.
ANALYSIS_MIN_INTERVAL_MS=2500

# Set to "true" to run with stub STT/LLM providers (no network, no keys needed).
# Useful for local UI work and CI. Real providers are used otherwise.
USE_STUB_PROVIDERS=false
